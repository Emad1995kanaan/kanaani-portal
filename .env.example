# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=production
# 32+ random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# SQLite (default) or PostgreSQL: postgresql+psycopg://kanaani:password@db:5432/kanaani
DATABASE_URL=sqlite:////app/data/kanaani.db
# Keep true behind HTTPS. Set false only for local http testing.
COOKIE_SECURE=true
# true only when running behind your own reverse proxy (Caddy/Nginx) that sets X-Forwarded-For
TRUSTED_PROXY=true
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=120
ENABLE_API_DOCS=false
